# App
APP_NAME=TalentOS
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# PostgreSQL (use a managed PostgreSQL database in production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talentos
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/talentos
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# AI failover order: Gemini key 1, Gemini key 2, then xAI Grok.
# Use keys from accounts you are authorized to use. Keep all keys server-side.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_2=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=grok-3-mini
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_RETRIES_PER_PROVIDER=1
AI_PROVIDER_COOLDOWN_SECONDS=60

# Admin seed: development defaults ONLY. Change before deployment.
ADMIN_SEED_EMAIL=admin@talentos.com
ADMIN_SEED_PASSWORD=@talentos123

# Optional integrations (add when their modules are implemented)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
